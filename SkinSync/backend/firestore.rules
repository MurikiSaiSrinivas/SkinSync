rules_version = '2';

// SkinSync Firestore rules.
// Principle: an anonymous user may only touch their own document tree.
service cloud.firestore {
  match /databases/{database}/documents {

    // /users/{uid} : the signed-in (anonymous) user's profile
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // /users/{uid}/looks/{lookId} : saved color recommendations
      match /looks/{lookId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Everything else denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
